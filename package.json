{
  "name": "atlasagents-web",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas Agents product / marketing site (atlasagents.dev). Frontend-only — no DB, no auth backend, no secrets.",
  "scripts": {
    "predev": "lsof -ti:3002 | xargs kill 2>/dev/null || true",
    "dev": "next dev -p 3002",
    "build": "next build",
    "postbuild": "rm -rf .next/standalone/public .next/standalone/.next/static && cp -R public .next/standalone/public && cp -R .next/static .next/standalone/.next/static",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lenis": "^1.3.23",
    "lucide-react": "^0.577.0",
    "next": "16.2.1",
    "posthog-js": "^1.382.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
