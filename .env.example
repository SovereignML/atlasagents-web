# Atlas Agents landing site (atlasagents.dev) — FRONTEND ONLY.
# No database, no auth backend, no secrets. Copy to `.env` for local dev.

# --- Hosts ---
# The platform app. All auth/app links (login, register, dashboard, admin, …)
# redirect here from the landing. See next.config.ts.
NEXT_PUBLIC_APP_URL="https://app.atlasagents.dev"

# This site's own canonical host — drives the www → apex redirect.
NEXT_PUBLIC_SITE_URL="https://atlasagents.dev"

# --- Analytics (optional; blank disables) ---
# PostHog is proxied through /ingest (see next.config.ts rewrites) so ad-blockers
# don't drop events.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# NOTE: src/configs/plans.ts references STRIPE_PRICE_* env vars, but they are
# INERT here — pricing display uses static numbers and checkout happens on the
# app. They can stay unset on the landing.
